alternate-normal-foreground: #DEDFCA;
alternate-urgent-background: #282826;
alternate-urgent-foreground: #DEDFCA;

selected-active-background: #656643;
selected-active-foreground: #282826;
selected-normal-background: #656643;
selected-normal-foreground: #282826;
selected-urgent-background: #516B32;
selected-urgent-foreground: #282826;

background-color: #282826;
background: rgba(0,0,0,0.7);
foreground: #DEDFCA;
border-color: #656643;

color0: #4D4D4B;
color1: #1E1E17;
color2: #24241B;
color3: #3D5025;
color4: #4C4C32;
color5: #74744A;
color6: #797A4D;
color7: #C8C9AB;
color8: #8C8C77;
color9: #28281F;
color10: #303023;
