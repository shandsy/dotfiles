 /* wallust template - colors-rofi */

* {
active-background: #656643;
active-foreground: #DEDFCA;
normal-background: #282826;
normal-foreground: #DEDFCA;
urgent-background: #9A9B62;
urgent-foreground: #DEDFCA;

alternate-active-background: #516B32;
alternate-active-foreground: #DEDFCA;
